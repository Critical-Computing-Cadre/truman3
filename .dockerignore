# Starts from nothing and lets in only what the API needs, so a secret can't slip in by accident.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/api
!apps/cli
!packages
# Sample content a new study can start with, for each kind of platform.
!studies/starters
# The example studies, which a server can set up as demos (ADR 78).
!studies/examples

packages/ui
**/node_modules
**/*.test.ts
**/*.test.tsx
**/*.itest.ts
**/testing.ts
**/tsconfig.json
