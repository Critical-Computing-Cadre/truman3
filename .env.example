# Copy to .env for local development. Matches compose.yaml.
DATABASE_URL=postgres://truman:truman@localhost:5432/truman
PORT=3000

# File storage. These point at the local SeaweedFS in compose.yaml, which ignores the keys.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=truman-media
# On AWS, leave both keys out, and storage uses the container's role.
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
# Where browsers fetch study images from. What participants upload goes through the API instead.
MEDIA_PUBLIC_URL=http://localhost:8333/truman-media

# Encrypts researchers' Prolific tokens, and on a hosted Truman each lab's own Claude key (ADR 71).
# Leave it out and connecting to Prolific, and labs' own keys, are turned off.
# Make one with: openssl rand -base64 32
# Keep it safe and don't change it, or everyone has to connect their account again.
TRUMAN_SECRET_KEY=
# Lets Christof's actors write their own words with Claude, for studies that turn live writing on.
# Leave it out and improvised beats use their fallback lines. Never commit a real key.
ANTHROPIC_API_KEY=
# The address participants use, in study links and the link Prolific sends people to.
# Required when NODE_ENV is production. Leave it out locally, or use this one.
PARTICIPANT_APP_URL=http://localhost:5180

# How many proxies sit in front of the API, so it can find each visitor's own address for rate
# limits. 0 locally. On AWS it's 2: CloudFront, then the load balancer.
# TRUSTED_PROXIES=0
# How many times a minute a researcher's login can be tried. 10 unless set.
# LOGIN_ATTEMPTS_PER_MINUTE=10
# Where Prolific's API is. Leave it out to use Prolific's own. The browser tests point it at a
# stand-in.
# PROLIFIC_API_URL=

# Only for updating a deployed database. See docs/guides/deploying.md. Local development doesn't need it.
# The password the API's login should have. The update creates the login if it isn't there.
# DATABASE_APP_PASSWORD=

# Email to researchers through Amazon SES (ADR 72): password resets and invitations. The From
# address must be on a domain verified in SES. Leave it out, and locally each email is printed in
# the terminal instead.
MAIL_FROM=
MAIL_REGION=us-east-1
# The admin app's address, for links in email. Locally it's this, the default.
ADMIN_APP_URL=http://localhost:5181/admin/

# Domains a study can run at instead of PARTICIPANT_APP_URL, separated by commas, so participants
# don't see "research" in the address bar (ADR 74). Each has to reach this server. Locally, none.
PARTICIPANT_DOMAINS=

# "true" makes this a hosted Truman: labs apply on the sign-in page, and an operator approves them
# (ADR 70). Make someone an operator with `pnpm admin operator <email>`.
HOSTED=false
