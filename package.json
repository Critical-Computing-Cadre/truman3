{
  "name": "truman3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --if-present build",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "study": "node --env-file-if-exists=.env apps/cli/src/main.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node --env-file-if-exists=.env packages/db/src/migrate-cli.ts",
    "db:generate": "pnpm --filter @truman3/db db:generate",
    "test:e2e": "pnpm --filter @truman3/e2e test",
    "test:e2e:built": "pnpm build && E2E_BUILT=1 pnpm --filter @truman3/e2e test",
    "check:container": "sh scripts/check-container.sh",
    "admin": "node --env-file-if-exists=.env apps/cli/src/admin.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0"
  }
}
