{
  "name": "truman3",
  "version": "3.0.0-beta.1",
  "private": true,
  "description": "A social media simulation platform for research",
  "license": "MIT",
  "homepage": "https://truman-research.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Critical-Computing-Cadre/truman3.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --if-present build",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "study": "node --env-file-if-exists=.env apps/cli/src/main.ts",
    "load-test": "node apps/cli/src/load-test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node --env-file-if-exists=.env packages/db/src/migrate-cli.ts",
    "db:generate": "pnpm --filter @truman3/db db:generate",
    "test:e2e": "pnpm --filter @truman3/e2e test",
    "test:e2e:built": "pnpm build && E2E_BUILT=1 pnpm --filter @truman3/e2e test",
    "check:container": "sh scripts/check-container.sh",
    "admin": "node --env-file-if-exists=.env apps/cli/src/admin.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0"
  }
}
